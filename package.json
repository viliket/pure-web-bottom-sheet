{
  "name": "pure-web-bottom-sheet",
  "version": "1.0.0",
  "description": "A performant, lightweight, and accessible bottom sheet web component powered by CSS scroll snap and CSS scroll-driven animations. Works with any framework, supports SSR, multiple snap points, and nested scrolling mode.",
  "keywords": [
    "bottom sheet",
    "modal",
    "drawer",
    "popup",
    "dialog",
    "overlay",
    "web component",
    "custom element",
    "vanilla js",
    "react",
    "vue",
    "typescript",
    "css scroll snap",
    "scroll-driven animations",
    "snap points",
    "accessible",
    "accessibility"
  ],
  "author": "Vili Ketonen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/viliket/pure-web-bottom-sheet/issues"
  },
  "homepage": "https://github.com/viliket/pure-web-bottom-sheet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viliket/pure-web-bottom-sheet.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/web/index.client.js",
  "unpkg": "./dist/browser.min.js",
  "jsdelivr": "./dist/browser.min.js",
  "exports": {
    ".": {
      "types": "./dist/web/index.client.d.ts",
      "default": "./dist/web/index.client.js"
    },
    "./ssr": {
      "types": "./dist/web/index.ssr.d.ts",
      "default": "./dist/web/index.ssr.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    }
  },
  "types": "./dist/web/index.client.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/web/index.client.d.ts"
      ],
      "ssr": [
        "./dist/web/index.ssr.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ],
      "vue": [
        "./dist/vue/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    ".",
    "examples/*"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "overrides": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@types/react": "^19.2.2",
    "@types/wait-on": "^5.3.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vue/language-core": "^3.3.9",
    "@wdio/cli": "^9.25.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.25.0",
    "@wdio/mocha-framework": "^9.25.0",
    "@wdio/spec-reporter": "^9.25.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "rollup": "^4.52.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-dts": "^1.0.0-beta.6",
    "unplugin-vue": "^7.0.3",
    "wait-on": "^9.0.4"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production rollup --config rollup.config.ts --configPlugin rollup-plugin-esbuild",
    "prepack": "npm run build",
    "watch": "NODE_ENV=development rollup --config rollup.config.ts --configPlugin rollup-plugin-esbuild --watch",
    "test:format": "prettier . --check",
    "test:types": "tsc --noEmit",
    "test:wdio": "wdio run ./wdio.conf.ts"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.7.0"
  }
}
